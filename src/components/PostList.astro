---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';
import { formatDate } from '../utils/formatDate';

type Post = CollectionEntry<'blog-en'> | CollectionEntry<'blog-tr'>;

interface Props {
  lang: Lang;
  posts: Post[];
  base: string;
}

const { lang, posts, base } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        {post.data.cover && (
          <a class="post-thumb" href={`${base}/${post.id}/`} tabindex="-1" aria-hidden="true">
            <img src={post.data.cover} alt="" loading="lazy" />
          </a>
        )}
        <div class="post-item-body">
          <time class="post-date" datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate, lang)}
          </time>
          <a class="post-link" href={`${base}/${post.id}/`}>{post.data.title}</a>
        </div>
      </li>
    ))
  }
</ul>
