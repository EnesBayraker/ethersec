---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Security notes, write-ups and my bug bounty journey.',
} = Astro.props;

const siteTitle = 'ethersec';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} · {siteTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href="/"><span class="prompt">~$</span> ethersec</a>
        <nav class="nav">
          <a href="/blog">yazılar</a>
          <a href="/tags">etiketler</a>
          <a href="/about">hakkımda</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="links">
          <a href="https://github.com/EnesBayraker" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/enes-bayraker-08489b295/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://medium.com/@bayrakerenes" target="_blank" rel="noopener">Medium</a>
          <a href="/rss.xml">RSS</a>
        </div>
        <p>© {new Date().getFullYear()} Enes Bayraker · ethersec</p>
      </div>
    </footer>
  </body>
</html>
