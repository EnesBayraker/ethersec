---
import '../styles/global.css';
import { getDict, type Lang } from '../i18n';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
}

const { title, description, lang = 'en', image } = Astro.props;
const dict = getDict(lang);
const siteTitle = 'ethersec';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? '/og-default.png', Astro.site);

const pathname = Astro.url.pathname;
const isTr = pathname.startsWith('/tr');
const enPath = isTr ? (pathname.replace(/^\/tr/, '') || '/') : pathname;
const trPath = isTr ? pathname : pathname === '/' ? '/tr/' : '/tr' + pathname;
const enURL = new URL(enPath, Astro.site);
const trURL = new URL(trPath, Astro.site);

const base = lang === 'tr' ? '/tr' : '';
const nav = [
  { href: `${base}/blog`, label: dict.nav.posts },
  { href: `${base}/tags`, label: dict.nav.tags },
  { href: `${base}/about`, label: dict.nav.about },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? dict.meta.defaultDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? dict.meta.defaultDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? dict.meta.defaultDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="tr" href={trURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} · {siteTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href={base === '' ? '/' : '/tr/'}><span class="prompt">~$</span> ethersec</a>
        <nav class="nav">
          {
            nav.map((n) => (
              <a href={n.href}>{n.label}</a>
            ))
          }
        </nav>
        <LanguageSwitcher lang={lang} />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="links">
          <a href="https://github.com/EnesBayraker" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/enes-bayraker-08489b295/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://medium.com/@bayrakerenes" target="_blank" rel="noopener">Medium</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </div>
        <p>© {new Date().getFullYear()} {dict.footer.copyright}</p>
      </div>
    </footer>
  </body>
</html>
